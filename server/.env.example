PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>
# MONGO_URI remains supported for deployments using the legacy variable.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRES_IN=12h
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
GNANI_API_KEY_ID=
GNANI_STT_LANGUAGE=hi-IN
GNANI_TTS_LANGUAGE=hi-IN
GNANI_TTS_VOICE=Nalini
GNANI_TTS_CONTAINER=wav
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Point only to a disposable replica-set database for test:integration.
MONGODB_TEST_URI=
